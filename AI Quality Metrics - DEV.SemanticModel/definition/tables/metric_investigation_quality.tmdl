	partition metric_investigation_quality = m
		mode: import
		queryGroup: Adoption
		source =
				let
				    Source =
				        Value.NativeQuery(
				            Databricks.Catalogs(
				                DBX_Server,
				                DBX_http,
				                [
				                    Catalog = DBX_Catalog,
				                    Database = null,
				                    QueryTags = null,
				                    EnableAutomaticProxyDiscovery = null,
				                    Implementation = "2.0",
				                    Protocol = null
				                ]
				            ){[Name = DBX_Catalog, Kind = "Database"]}[Data],
				
				            "
				                    select
				                    *
				                    from
				                    (
				                        select
				                        record_id,
				                        agent_type,
				                        DATE(EffectiveDate),
				                        Owning_Business_Unit,
				                        Owning_Organization_Entity,
				                        Local_Area,
				                        Department,
				                        MEASURE(measure_count_nr) as agent_used,
				                        MEASURE(measure_count_dr) as total_deviation,
				                        MEASURE(measure_count_agent_not_used_overallall) as agent_not_used_overall,
				                        round(measure(investigation_quality_percentage_adoption), 2) as adoption_pct,
				                        measure(measure_count_agent_not_used_nr) as agent_not_used,
				                        measure(investigation_quality_percentage_agent_adoption) as agent_adoption_pct
				                        from
				                        gsc_devtest_unified_uc.u_conf_qlty_iro.metric_investigation_quality
				                        group by
				                        all
				                    )
				            ",
				
				            null,
				            [EnableFolding = true]
				        )
				in
				    Source

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

