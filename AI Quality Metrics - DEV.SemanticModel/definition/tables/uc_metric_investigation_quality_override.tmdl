	partition uc_metric_investigation_quality_override = m
		mode: import
		queryGroup: Override
		source =
				let
				    Source =
				        Value.NativeQuery(
				            Databricks.Catalogs(
				                DBX_Server,
				                DBX_http,
				                [
				                    Catalog = DBX_Catalog,
				                    Database = null,
				                    QueryTags = null,
				                    EnableAutomaticProxyDiscovery = null,
				                    Implementation = "2.0",
				                    Protocol = null
				                ]
				            ){[Name = DBX_Catalog, Kind = "Database"]}[Data],
				
				            "
				            SELECT
				                `record_id`,
				                `agent_type`,
				                -- DATE(`EffectiveDate`),
				                DATE(`ModifiedDate`),
				                `Owning_Organization_Entity`,
				                `Owning_Business_Unit`,
				                `Local_Area`,
				                `department`,
				                `KPI_Category`,
				                `KPI_Value`,
				                `KPI_Name`,
				                `Parent_KPI_Name`,
				
				                -- MEASURE(`measure_count_nr`) AS `measure_count_nr`,
				                -- MEASURE(`measure_count_dr`) AS `measure_count_dr`,
				
				                MEASURE(`measure_count_nr_override`) AS `measure_count_nr_override`,
				                MEASURE(`measure_count_dr_override`) AS `measure_count_dr_override`,
				
				                -- MEASURE(`investigation_quality_percentage_adoption`) AS `investigation_quality_percentage_adoption`
				                MEASURE(`investigation_quality_percentage_override`) AS `investigation_quality_percentage_override`,
				
				                Similarity_Score
				            FROM
				            " & DBX_Catalog & ".u_conf_qlty_iro.metric_investigation_quality
				            --gsc_devtest_unified_uc.u_conf_qlty_iro.metric_investigation_quality
				            GROUP BY ALL
				            ",
				
				            null,
				            [EnableFolding = true]
				        )
				in
				    Source

