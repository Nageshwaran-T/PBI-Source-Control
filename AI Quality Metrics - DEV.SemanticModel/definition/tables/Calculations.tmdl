	measure 'Date In Fact Range' = ```
			
			
			VAR MinDate = 
			CALCULATE (
			    MIN ( investigation_quality_agent_score[last_actioned_date] ),
			    ALL ( 'Date' )
			)
			
			VAR MaxDate = 
			CALCULATE (
			    MAX ( investigation_quality_agent_score[last_actioned_date] ),
			    ALL ( 'Date' )
			)
			
			RETURN
			IF (
			    MAX ( 'Date'[Date] ) >= MinDate &&
			    MAX ( 'Date'[Date] ) <= MaxDate,
			    1,
			    0
			)
			```
		formatString: 0
		displayFolder: agent score\score
		lineageTag: 48763daf-ea0c-4df8-856b-9a6c5b8e99c2

	measure 'Date In Adoption Range' = ```
			
			
			VAR MinDate = 
			CALCULATE (
			    MIN ( metric_investigation_quality[EffectiveDate] ),
			    ALL ( 'Date' )
			)
			
			VAR MaxDate = 
			CALCULATE (
			    MAX (metric_investigation_quality[EffectiveDate] ),
			    ALL ( 'Date' )
			)
			
			RETURN
			IF (
			    MAX ( 'Date'[Date] ) >= MinDate &&
			    MAX ( 'Date'[Date] ) <= MaxDate,
			    1,
			    0
			)
			```
		formatString: 0
		displayFolder: Adoption
		lineageTag: 50acfc69-116b-4419-ae55-4978ee3a71df

