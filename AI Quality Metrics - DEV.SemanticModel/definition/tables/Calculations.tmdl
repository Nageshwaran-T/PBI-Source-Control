	measure 'Override %' =
			
			AVERAGEA(uc_metric_investigation_quality_override[investigation_quality_percentage_override]) / 100
			
			-- 📌 below is old % logic
			/*
			VAR _count_nr = [Override Numerator Count]
			VAR _count_dr = [Override Denominator Count]
			RETURN
			SWITCH(
			        TRUE(),
			        _count_nr = 0 && _count_dr = 0, BLANK(),        -- both 0 → blank
			        _count_nr = 0 && _count_dr > 0, 0,              -- nr = 0, dr > 0 → 0%
			        _count_nr > 0 && _count_dr = 0, BLANK(),        -- nr > 0, dr = 0 → #N/A alternative
