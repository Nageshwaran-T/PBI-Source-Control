table Calculations
	lineageTag: d00c6703-acaf-4ad9-8a78-d43f5b1d4810

	measure 'Relevance Scorer' =
			
			VAR AvgScore =
			    CALCULATE(
			        AVERAGE(investigation_quality_agent_score[relevance_score]),
			        investigation_quality_agent_score[is_current] = 1
			    )
			RETURN
			DIVIDE(AvgScore, 5)
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: agent score\score
		lineageTag: 017828ee-2796-49f8-be63-cbf4d9fdd95a

