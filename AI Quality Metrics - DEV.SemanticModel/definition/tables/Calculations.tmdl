	measure 'Overall Scorer' =
			
			DIVIDE([Relevance Scorer] + [Completeness Scorer] + [Instruction-Following Scorer] + [Coherence / Fluency Scorer], 4)
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: agent score\score
		lineageTag: 6ad3b586-93f5-4036-8a29-d2d13adf504c

	measure 'Overall Scorer (Text)' =
			
			FORMAT (
			    DIVIDE(AVERAGE ( investigation_quality_agent_score[relevance_score] ) + AVERAGE ( investigation_quality_agent_score[Completeness_score] ) +  AVERAGE ( investigation_quality_agent_score[instruction_following_score] ) + AVERAGE ( investigation_quality_agent_score[coherence_score] ), 4),
			    "#,##0.0"
			) & " / 5"
		displayFolder: agent score\score text
